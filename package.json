{
  "name": "pi-rescue-runtime",
  "version": "0.1.0",
  "description": "A fieldops/rescue skill-pack for the pi coding agent: diagnose, harden, and recover any box — with SSH-tunnel, remote-session (fleet) and key management — RAG-augmented for a small local model or the metabolomics gateway.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "pi-rescue": "./scripts/pi-rescue.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "node --test \"test/**/*.test.ts\"",
    "build-index": "node scripts/pi-rescue.ts build-index"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "yaml": "^2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  },
  "optionalDependencies": {
    "sqlite-vec": "^0.1.9"
  }
}
